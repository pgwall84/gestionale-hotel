# Copia questo file in .env e compila con i tuoi valori reali

# Connessione PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestionale_hotel
DB_USER=postgres
DB_PASSWORD=cambia_questa_password

# Chiave segreta per firmare i token JWT — usare una stringa lunga e casuale
JWT_SECRET=cambia_questa_chiave_segreta_molto_lunga

# Durata del token JWT (es. 8h = otto ore, 1d = un giorno)
JWT_EXPIRES_IN=8h

# Porta su cui gira il server Express
PORT=7001

# Ambiente (development / production)
NODE_ENV=development

# URL del frontend in produzione — usato da CORS (app.js) per limitare l'origine
# accettata. Obbligatorio quando NODE_ENV=production, altrimenti CORS blocca
# tutte le richieste (nessun fallback silenzioso su '*').
FRONTEND_URL=https://your-domain.com

# Alloggiati Web (WS_ALLOGGIATI) — modulo 2.5, Fase 1b/2. Credenziali già
# assegnate dalla Questura, non ancora usate finché non si preme
# "Sincronizza ora" in Impostazioni ▸ Alloggiati Web (sola lettura, Fase 1b)
# o si invia una schedina reale (Fase 2, non ancora sviluppata).
ALLOGGIATI_UTENTE=
ALLOGGIATI_PASSWORD=
ALLOGGIATI_WSKEY=

# Resend (email automatiche prenotazioni) — modulo 5.3, parte email.
# In sviluppo, senza un dominio verificato: RESEND_MITTENTE deve restare
# onboarding@resend.dev e Resend consegnerà SOLO all'indirizzo email con cui
# hai creato l'account Resend (limite della modalità sandbox, non un bug).
# Quando verificherai un dominio tuo (es. mail.hoteldelgolfolerici.com),
# cambia solo RESEND_MITTENTE — nessuna modifica al codice.
RESEND_API_KEY=
RESEND_MITTENTE=onboarding@resend.dev

# Pre check-in self-service (modulo 5.2 Fase B) — base URL usata per
# costruire il link pubblico /pre-checkin/<token> mandato via email.
# In sviluppo: l'IP LAN del PC (stesso usato in
# frontend/next.config.ts → allowedDevOrigins), es. http://192.168.1.8:7000
# — cambia ogni giorno via DHCP, verificare con ipconfig prima di ogni
# sessione di test da mobile. In produzione: il dominio pubblico (stesso
# valore di FRONTEND_URL). Se non impostata, ricade su FRONTEND_URL e poi
# su http://localhost:7000 — utile solo per test da PC, MAI raggiungibile
# da un telefono reale.
PRE_CHECKIN_BASE_URL=

# Export ROSS1000/ISTAT (modulo 2.6, Fase 1 — 04/08/2026). Codice
# identificativo della struttura assegnato da Regione Liguria (elemento
# <codice> del tracciato, docs/ross1000/tracciato.pdf) — non ancora noto,
# da chiedere all'Ufficio Turismo competente insieme alle credenziali
# HTTP Basic del webservice (necessarie solo in Fase 2, invio reale, non
# ancora implementata). Senza questa variabile l'XML generato riporta
# "DA_CONFIGURARE" al posto del codice reale — utile comunque per
# verificare manualmente il resto del contenuto.
ROSS1000_CODICE_STRUTTURA=

# Stripe (Booking Engine Diretto, modulo 19/08/2026) — caparra 30% via
# PaymentIntent, saldo incassato in hotel con il POS Nexi esistente.
# Chiavi di test (sk_test_/pk_test_/whsec_test_) finché non si passa in
# produzione. STRIPE_WEBHOOK_SECRET si ottiene creando l'endpoint webhook
# nella dashboard Stripe (o con `stripe listen` in sviluppo locale).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sanity (Booking Engine v2, Fase B — 19/08/2026) — SOLO per lo script una
# tantum backend/scripts/collegaSanityTipiCamera.js, mai usato dal server in
# esecuzione normale. SANITY_PROJECT_ID/SANITY_DATASET: stessi valori di
# sito-hotel/.env.local (NEXT_PUBLIC_SANITY_PROJECT_ID/DATASET). Token da
# creare in https://www.sanity.io/manage → progetto → API → Tokens → ruolo
# "Editor" (permesso di scrittura) — MAI il token pubblico di sola lettura
# già in uso dal sito.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
